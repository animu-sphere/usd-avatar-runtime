@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/AvatarRuntimeTargets.cmake")
if("vrm" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmRig CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmAdapterTargets.cmake")
        set(AvatarRuntime_vrm_FOUND TRUE)
    endif()
endif()
if("motion" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_motion_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMotionAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionSampling CONFIG)
        find_dependency(motionRetarget 0.5.3 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionAdapterTargets.cmake")
        set(AvatarRuntime_motion_FOUND TRUE)
    endif()
endif()
if("usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "motion_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_usd_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionRetarget 0.5.3 CONFIG)
        find_dependency(pxr CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarUsdBindingTargets.cmake")
        set(AvatarRuntime_usd_FOUND TRUE)
    endif()
endif()
if("vrm_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_usd_FOUND FALSE)
    if(AvatarRuntime_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmSchema 0.9.0 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmUsdBindingTargets.cmake")
        set(AvatarRuntime_vrm_usd_FOUND TRUE)
    endif()
endif()
if("motion_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_motion_usd_FOUND FALSE)
    if(AvatarRuntime_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMotionUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionUsd 0.5.3 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionUsdBindingTargets.cmake")
        set(AvatarRuntime_motion_usd_FOUND TRUE)
    endif()
endif()
check_required_components(AvatarRuntime)
