@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/AvatarRuntimeTargets.cmake")
if("vrm_session" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    list(APPEND AvatarRuntime_FIND_COMPONENTS vrm_usd vrm_spring_usd vrm_spring motion_usd motion)
endif()
if("vrm_spring" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_spring_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpringAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmRig CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpring.cmake")
        avatar_require_vrm_spring_solver()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpringAdapterTargets.cmake")
        set(AvatarRuntime_vrm_spring_FOUND TRUE)
    endif()
endif()
if("vrm_spring_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    list(APPEND AvatarRuntime_FIND_COMPONENTS usd)
endif()
if("mmd_session" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    list(APPEND AvatarRuntime_FIND_COMPONENTS mmd usd stage_runner physics_usd)
endif()
if("physics_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_physics_usd_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarPhysicsUsdResourcesTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(physicsUsd 0.1 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarPhysicsUsdResourcesTargets.cmake")
        set(AvatarRuntime_physics_usd_FOUND TRUE)
    endif()
endif()
if("stage_runner" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_stage_runner_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarStageRunnerSessionTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(runtimeCore 0.1 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarStageRunnerSessionTargets.cmake")
        set(AvatarRuntime_stage_runner_FOUND TRUE)
    endif()
endif()
if("mmd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_mmd_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMmdAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(mmdPhysicsAdapter 0.2 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMmdMorphResolution.cmake")
        avatar_require_mmd_morph_resolution()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMmdAdapterTargets.cmake")
        set(AvatarRuntime_mmd_FOUND TRUE)
    endif()
endif()
if("vrm" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_lookat_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_expression_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmRig CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmAdapterTargets.cmake")
        set(AvatarRuntime_vrm_FOUND TRUE)
    endif()
endif()
if("motion" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_motion_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMotionAdapterTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionSampling 0.5.4 CONFIG)
        find_dependency(motionRetarget 0.5.4 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionValidation.cmake")
        avatar_require_motion_validation()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionAdapterTargets.cmake")
        set(AvatarRuntime_motion_FOUND TRUE)
    endif()
endif()
if("usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "motion_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_lookat_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_expression_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_usd_FOUND FALSE)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionRetarget 0.5.4 CONFIG)
        find_dependency(motionUsd 0.5.4 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionUsdReading.cmake")
        avatar_require_motion_usd_reading()
        find_dependency(pxr CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarUsdBindingTargets.cmake")
        set(AvatarRuntime_usd_FOUND TRUE)
    endif()
endif()
if("vrm_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_lookat_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS OR "vrm_expression_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_usd_FOUND FALSE)
    if(AvatarRuntime_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmSchema 0.9.0 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmUsdBindingTargets.cmake")
        set(AvatarRuntime_vrm_usd_FOUND TRUE)
    endif()
endif()
if("vrm_lookat_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_lookat_usd_FOUND FALSE)
    if(AvatarRuntime_vrm_usd_FOUND AND AvatarRuntime_vrm_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmLookAtUsdBindingTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmLookAtUsdBindingTargets.cmake")
        set(AvatarRuntime_vrm_lookat_usd_FOUND TRUE)
    endif()
endif()
if("motion_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_motion_usd_FOUND FALSE)
    if(AvatarRuntime_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMotionUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(motionUsd 0.5.4 CONFIG)
        avatar_require_motion_usd_inputs()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMotionUsdBindingTargets.cmake")
        set(AvatarRuntime_motion_usd_FOUND TRUE)
    endif()
endif()
if("vrm_expression_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_expression_usd_FOUND FALSE)
    if(AvatarRuntime_vrm_usd_FOUND AND AvatarRuntime_vrm_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmExpressionUsdBindingTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmExpressionUsdBindingTargets.cmake")
        set(AvatarRuntime_vrm_expression_usd_FOUND TRUE)
    endif()
endif()
if("mmd_session" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_mmd_session_FOUND FALSE)
    if(AvatarRuntime_mmd_FOUND AND AvatarRuntime_usd_FOUND AND AvatarRuntime_stage_runner_FOUND
            AND AvatarRuntime_physics_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarMmdSessionTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(physicsJolt 0.1 CONFIG)
        if(NOT mmdPhysicsAdapter_SOURCE_BODY_PROPERTIES_VERSION EQUAL 1 OR
                NOT mmdPhysicsAdapter_JOINT_ADMISSION_VERSION EQUAL 1 OR
                NOT physicsCore_DAMPING_RESPONSE_VERSION EQUAL 1 OR
                NOT physicsJolt_PRIOR_VELOCITY_CLEARING_AVAILABLE)
            message(FATAL_ERROR "MMD session requires owner joint admission, source-policy body properties and prior-velocity clearing; rebuild/install the complete owner/physics/runtime closure")
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarMmdSessionTargets.cmake")
        set(AvatarRuntime_mmd_session_FOUND TRUE)
    endif()
endif()
if("vrm_spring_usd" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_spring_usd_FOUND FALSE)
    if(AvatarRuntime_usd_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpringUsdBindingTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(vrmRig CONFIG)
        find_dependency(vrmSchema 0.10 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpring.cmake")
        avatar_require_vrm_spring()
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSpringUsdBindingTargets.cmake")
        set(AvatarRuntime_vrm_spring_usd_FOUND TRUE)
    endif()
endif()
if("vrm_session" IN_LIST AvatarRuntime_FIND_COMPONENTS)
    set(AvatarRuntime_vrm_session_FOUND FALSE)
    if(AvatarRuntime_vrm_usd_FOUND AND AvatarRuntime_vrm_spring_usd_FOUND AND AvatarRuntime_vrm_spring_FOUND
            AND AvatarRuntime_motion_usd_FOUND AND AvatarRuntime_motion_FOUND
            AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSessionTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/AvatarVrmSessionTargets.cmake")
        set(AvatarRuntime_vrm_session_FOUND TRUE)
    endif()
endif()
check_required_components(AvatarRuntime)
